@port = 9001
@token = Bearer eyJhbGciOiJIUzUxMiJ9..5alQHZv6qS411enEHOGrH-KKL_NhwohmLA8D9B_8NBdzedB24t8XJAW8X0SSOgTbZv_xoz_8qi6nn1WIaAkBdQ

@base = http://localhost:{{port}}/api/patient-habits

@pacienteId = 5
@otroPacienteId = 2
@habitoId = 1
@habitoInexistenteId = 99999
@pacienteInexistenteId = 99999

### HU-FASE2-081 — Crear hábito ACTIVO de tabaco
POST {{base}}
Content-Type: application/json
Authorization: {{token}}

{
  "patientId": {{pacienteId}},
  "habitType": "TABACO",
  "description": "Fumador activo de cigarrillo industrial.",
  "frequency": "Diaria",
  "quantity": "10 cigarrillos/día",
  "consumptionTime": "15 años",
  "startDate": "2010-06-01",
  "status": "ACTIVO",
  "observations": "Paciente refiere intentos previos de cesación sin éxito."
}

###

### HU-FASE2-081 — Crear hábito ACTIVO de alcohol
POST {{base}}
Content-Type: application/json
Authorization: {{token}}

{
  "patientId": {{pacienteId}},
  "habitType": "ALCOHOL",
  "description": "Consumo social de alcohol los fines de semana.",
  "frequency": "Semanal",
  "quantity": "3-4 copas",
  "consumptionTime": "10 años",
  "status": "OCASIONAL"
}

###

### HU-FASE2-081 — Crear hábito EX_CONSUMIDOR (sustancias) con fecha de fin
POST {{base}}
Content-Type: application/json
Authorization: {{token}}

{
  "patientId": {{pacienteId}},
  "habitType": "SUSTANCIAS_PSICOACTIVAS",
  "description": "Consumo de marihuana en la adolescencia, suspendido hace 8 años.",
  "frequency": "Ocasional",
  "startDate": "2008-01-01",
  "endDate": "2017-12-15",
  "status": "EX_CONSUMIDOR",
  "observations": "Reporta abstinencia mantenida."
}

###

### HU-FASE2-081 — Crear hábito de ejercicio
POST {{base}}
Content-Type: application/json
Authorization: {{token}}

{
  "patientId": {{pacienteId}},
  "habitType": "EJERCICIO",
  "description": "Caminata de 30 minutos diarios y rutina aeróbica 2 veces por semana.",
  "frequency": "Diaria",
  "status": "ACTIVO"
}

###

### HU-FASE2-081 — Consultar hábito por ID
GET {{base}}/{{habitoId}}
Authorization: {{token}}

###

### HU-FASE2-081 — Listar hábitos del paciente
POST {{base}}/list
Content-Type: application/json
Authorization: {{token}}

{
  "page": 0,
  "rows": 20,
  "search": "",
  "order_by": "h.created_at",
  "order": "DESC",
  "params": {
    "patientId": {{pacienteId}}
  }
}

###

### HU-FASE2-081 — Listar solo hábitos en estado ACTIVO
POST {{base}}/list
Content-Type: application/json
Authorization: {{token}}

{
  "page": 0,
  "rows": 20,
  "search": "",
  "order_by": "h.created_at",
  "order": "DESC",
  "params": {
    "patientId": {{pacienteId}},
    "onlyCurrentlyActive": true
  }
}

###

### HU-FASE2-081 — Filtrar por tipo de hábito (TABACO)
POST {{base}}/list
Content-Type: application/json
Authorization: {{token}}

{
  "page": 0,
  "rows": 20,
  "search": "",
  "order_by": "h.created_at",
  "order": "DESC",
  "params": {
    "patientId": {{pacienteId}},
    "habitType": "TABACO"
  }
}

###

