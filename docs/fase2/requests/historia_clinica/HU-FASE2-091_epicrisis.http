### HU-FASE2-091 — Actualizar epicrisis (solo si NO está firmada)
PUT {{base}}/{{epicrisisId}}
Content-Type: application/json
Authorization: {{token}}

{
  "professionalId": {{profesionalId}},
  "admissionReason": "Dolor abdominal súbito en FID.",
  "admissionDiagnosis": "K35.9 - Apendicitis aguda.",
  "dischargeDiagnosis": "K35.3 - Apendicitis aguda con peritonitis localizada.",
  "proceduresPerformed": "Apendicectomía laparoscópica.",
  "evolutionSummary": "Postquirúrgico sin complicaciones. Tolera vía oral.",
  "followUpPlan": "Control con cirugía en 7 días. Retirar puntos día 10.",
  "dischargeMedications": "Acetaminofén 500mg c/8h x 5 días.",
  "recommendations": "Reposo. Mantener herida limpia. Consulta por signos de alarma.",
  "dietInstructions": "Blanda por 3 días.",
  "activityInstructions": "Reposo relativo 7 días.",
  "nextControlDate": "2026-05-17",
  "pdfUrl": "https://storage.mednova.local/epicrisis/EP-DRAFT.pdf"
}

