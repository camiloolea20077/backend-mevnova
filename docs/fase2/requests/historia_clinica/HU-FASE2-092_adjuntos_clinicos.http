@base = http://localhost:{{port}}/api/clinical-attachments

@pacienteId = 5
@atencionId = 1
@profesionalId = 2
@adjuntoId = 1
@adjuntoConfidencialId = 2
@adjuntoInexistenteId = 99999
@pacienteInexistenteId = 99999
@atencionInexistenteId = 99999
@profesionalInexistenteId = 99999

### HU-FASE2-092 CA1 — Subir adjunto: resultado de laboratorio
POST {{base}}
Content-Type: application/json
Authorization: {{token}}

{
  "patientId": {{pacienteId}},
  "encounterId": {{atencionId}},
  "documentType": "RESULTADO_LABORATORIO",
  "fileName": "Hemograma_2026-05-08.pdf",
  "description": "Hemograma completo realizado en laboratorio externo.",
  "fileUrl": "https://storage.mednova.local/attachments/HEM-2026-0008.pdf",
  "mimeType": "application/pdf",
  "sizeBytes": 248320,
  "uploadingProfessionalId": {{profesionalId}},
  "documentDate": "2026-05-08",
  "isConfidential": false
}

###

### HU-FASE2-092 CA1 — Subir adjunto: imagen diagnóstica (RX tórax)
POST {{base}}
Content-Type: application/json
Authorization: {{token}}

{
  "patientId": {{pacienteId}},
  "encounterId": {{atencionId}},
  "documentType": "IMAGEN_DIAGNOSTICA",
  "fileName": "RX_Torax_PA_2026-05-09.jpg",
  "description": "Radiografía de tórax proyección PA. Sin hallazgos patológicos.",
