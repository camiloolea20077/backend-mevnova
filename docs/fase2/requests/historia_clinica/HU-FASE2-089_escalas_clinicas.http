### HU-FASE2-089 — Aplicar APGAR neonatal (escala sin riesgo automático)
POST {{base}}
Content-Type: application/json
Authorization: {{token}}

{
  "encounterId": {{atencionId}},
  "patientId": {{pacienteId}},
  "professionalId": {{profesionalId}},
  "scaleType": "APGAR",
  "totalScore": 9,
  "risk": "BAJO",
  "scaleDetail": {
    "minuto_1": 8,
    "minuto_5": 9,
    "frecuencia_cardiaca": 2,
    "esfuerzo_respiratorio": 2,
    "tono_muscular": 1,
    "respuesta_estimulo": 2,
    "color_piel": 2
  },
  "observations": "Recién nacido con buen pronóstico."
}

