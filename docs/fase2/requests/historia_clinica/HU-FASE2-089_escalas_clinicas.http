### HU-FASE2-089 — Aplicar BARTHEL (escala sin fórmula automática, riesgo manual)
POST {{base}}
Content-Type: application/json
Authorization: {{token}}

{
  "encounterId": {{atencionId}},
  "patientId": {{pacienteId}},
  "professionalId": {{profesionalId}},
  "scaleType": "BARTHEL",
  "totalScore": 40,
  "risk": "ALTO",
  "interpretation": "Dependencia grave en AVD.",
  "scaleDetail": {
    "comida": 5,
    "lavado": 0,
    "vestido": 5,
    "arreglo": 0,
    "deposiciones": 5,
    "miccion": 10,
    "uso_retrete": 5,
    "trasferencias": 5,
    "deambulacion": 5,
    "escalones": 0
  }
}

