@port = 9001
@token = Bearer eyJhbGciOiJIUzUxMiJ9..KIkh7aX0OCMAIkvJbPM1-OjEKdEkrgZTX6H0ycQup_2HMRw8Hu2QuhP_hpwy3885OPN2nWqExENuvusgKvCwoQ

@base = http://localhost:{{port}}/api/interconsultations

@atencionOrigenId = 1
@atencionRespuestaId = 2
@profesionalSolicitaId = 2
@profesionalRespondeId = 3
@especialidadId = 53
@especialidadOtraId = 2
@interconsultaId = 1
@interconsultaRespondidaId = 2
@interconsultaInexistenteId = 99999
@atencionInexistenteId = 99999
@profesionalInexistenteId = 99999
@especialidadInexistenteId = 99999

### HU-FASE2-090 CA1 — Solicitar interconsulta NORMAL
POST {{base}}
Content-Type: application/json
Authorization: {{token}}

{
  "originEncounterId": {{atencionOrigenId}},
  "requestingProfessionalId": {{profesionalSolicitaId}},
  "destinationSpecialtyId": {{especialidadId}},
  "reason": "Paciente con dolor torácico atípico de 24 horas de evolución. Solicito valoración para descartar evento coronario agudo.",
  "diagnosticImpression": "Probable angina inestable vs. dolor musculoesquelético.",
  "clinicalQuestion": "¿Requiere estratificación con troponinas seriadas y ECG seriado?",
  "priority": "NORMAL"
}

###

### HU-FASE2-090 CA1 — Solicitar interconsulta URGENTE
POST {{base}}
Content-Type: application/json
Authorization: {{token}}

{
  "originEncounterId": {{atencionOrigenId}},
  "requestingProfessionalId": {{profesionalSolicitaId}},
  "destinationSpecialtyId": {{especialidadId}},
  "reason": "Paciente con tensión arterial sostenida 180/110 mmHg refractaria a manejo inicial.",
  "diagnosticImpression": "Crisis hipertensiva.",
  "clinicalQuestion": "¿Ajuste de esquema antihipertensivo y necesidad de UCI?",
  "priority": "URGENTE"
}

###

### HU-FASE2-090 CA1 — Solicitar interconsulta VITAL (aparece al inicio del listado)
POST {{base}}
Content-Type: application/json
Authorization: {{token}}

{
  "originEncounterId": {{atencionOrigenId}},
  "requestingProfessionalId": {{profesionalSolicitaId}},
  "destinationSpecialtyId": {{especialidadOtraId}},
  "reason": "Paciente con deterioro neurológico súbito, Glasgow 7/15.",
  "diagnosticImpression": "Probable ACV isquémico extenso.",
  "clinicalQuestion": "Manejo en UCI neurológica.",
  "priority": "VITAL"
}

###

### HU-FASE2-090 — Consultar interconsulta por ID
GET {{base}}/{{interconsultaId}}
Authorization: {{token}}

###

### HU-FASE2-090 CA2 — Bandeja del especialista (cross-sede, ordenadas por prioridad VITAL > URGENTE > NORMAL)
POST {{base}}/list
Content-Type: application/json
Authorization: {{token}}

{
  "page": 0,
  "rows": 50,
  "search": "",
  "params": {
    "destinationSpecialtyId": {{especialidadId}},
    "onlyPending": true,
    "crossSede": true
  }
}

###

### HU-FASE2-090 — Mis interconsultas solicitadas (PENDIENTE+EN_PROCESO+RESPONDIDA)
POST {{base}}/list
Content-Type: application/json
Authorization: {{token}}

{
  "page": 0,
  "rows": 50,
  "search": "",
  "order_by": "i.fecha_solicitud",
  "order": "DESC",
  "params": {
    "requestingProfessionalId": {{profesionalSolicitaId}}
  }
}

###

### HU-FASE2-090 — Pendientes VITALES (cross-sede)
POST {{base}}/list
Content-Type: application/json
Authorization: {{token}}

{
  "page": 0,
  "rows": 20,
  "search": "",
  "params": {
    "priority": "VITAL",
    "onlyPending": true,
    "crossSede": true
  }
}

###

### HU-FASE2-090 — Interconsultas de la atención
POST {{base}}/list
Content-Type: application/json
Authorization: {{token}}

{
  "page": 0,
  "rows": 50,
  "search": "",
  "params": {
    "originEncounterId": {{atencionOrigenId}}
  }
}

###

### HU-FASE2-090 — Búsqueda por número, motivo o pregunta clínica
POST {{base}}/list
Content-Type: application/json
Authorization: {{token}}

{
  "page": 0,
  "rows": 20,
  "search": "IC-000001",
  "params": {}
}

###

### HU-FASE2-090 — Rango de fechas
POST {{base}}/list
Content-Type: application/json
Authorization: {{token}}

{
  "page": 0,
  "rows": 50,
  "search": "",
  "params": {
    "requestedFrom": "2026-05-01",
    "requestedTo": "2026-05-31"
  }
}

###

### HU-FASE2-090 — Editar solicitud antes de ser tomada (PENDIENTE)
PUT {{base}}/{{interconsultaId}}
Content-Type: application/json
Authorization: {{token}}

{
  "destinationSpecialtyId": {{especialidadId}},
  "reason": "Paciente con dolor torácico atípico de 24h. Se agrega que refiere sudoración fría desde hace 2 horas.",
  "diagnosticImpression": "Sospecha de SCA. Troponinas en curso.",
  "clinicalQuestion": "Estratificación y conducta.",
  "priority": "URGENTE"
}

###

### HU-FASE2-090 — Tomar interconsulta (PENDIENTE → EN_PROCESO)
PATCH {{base}}/{{interconsultaId}}/take
Content-Type: application/json
Authorization: {{token}}

{
  "respondingProfessionalId": {{profesionalRespondeId}}
}

###

### HU-FASE2-090 CA3 — Responder interconsulta (enlaza atención de respuesta, marca RESPONDIDA)
PATCH {{base}}/{{interconsultaId}}/respond
Content-Type: application/json
Authorization: {{token}}

{
  "respondingProfessionalId": {{profesionalRespondeId}},
  "response": "Paciente valorado. ECG con ondas T negativas en derivadas precordiales. Troponinas en aumento. Se diagnostica SCA sin elevación del ST.",
  "recommendations": "Iniciar doble antiagregación, anticoagulación con HBPM, atorvastatina 80mg/día. Traslado a UCI coronaria. Programar cateterismo en próximas 24 horas.",
  "responseEncounterId": {{atencionRespuestaId}}
}

###

### HU-FASE2-090 — Responder interconsulta sin nueva atención (solo recomendaciones)
PATCH {{base}}/{{interconsultaId}}/respond
Content-Type: application/json
Authorization: {{token}}

{
  "respondingProfessionalId": {{profesionalRespondeId}},
  "response": "Por características clínicas, dolor de origen musculoesquelético.",
  "recommendations": "AINES por 5 días. Control si persiste sintomatología."
}

###

### HU-FASE2-090 — Anular interconsulta (PENDIENTE o EN_PROCESO)
PATCH {{base}}/{{interconsultaId}}/cancel
Content-Type: application/json
Authorization: {{token}}

{
  "reason": "Paciente trasladado a otra institución de mayor complejidad."
}

###

### HU-FASE2-090 — Eliminación lógica (no aplica a RESPONDIDA)
DELETE {{base}}/{{interconsultaId}}
Authorization: {{token}}

###

### HU-FASE2-090 — Validación: campo obligatorio (reason faltante)
POST {{base}}
Content-Type: application/json
Authorization: {{token}}

{
  "originEncounterId": {{atencionOrigenId}},
  "requestingProfessionalId": {{profesionalSolicitaId}},
  "destinationSpecialtyId": {{especialidadId}}
}

###

### HU-FASE2-090 — Validación: prioridad inválida (400)
POST {{base}}
Content-Type: application/json
Authorization: {{token}}

{
  "originEncounterId": {{atencionOrigenId}},
  "requestingProfessionalId": {{profesionalSolicitaId}},
  "destinationSpecialtyId": {{especialidadId}},
  "reason": "Sin descripción",
  "priority": "ALTA"
}

###

### HU-FASE2-090 — Validación: atención inexistente o de otra sede (404)
