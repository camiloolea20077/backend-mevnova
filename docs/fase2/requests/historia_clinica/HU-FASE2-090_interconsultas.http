Content-Type: application/json
Authorization: {{token}}

{
  "originEncounterId": {{atencionInexistenteId}},
  "requestingProfessionalId": {{profesionalSolicitaId}},
  "destinationSpecialtyId": {{especialidadId}},
  "reason": "Prueba"
}

###

### HU-FASE2-090 — Validación: profesional inexistente (404)
POST {{base}}
Content-Type: application/json
Authorization: {{token}}

{
  "originEncounterId": {{atencionOrigenId}},
  "requestingProfessionalId": {{profesionalInexistenteId}},
  "destinationSpecialtyId": {{especialidadId}},
  "reason": "Prueba"
}

###

### HU-FASE2-090 — Validación: especialidad inexistente (404)
POST {{base}}
Content-Type: application/json
Authorization: {{token}}

{
  "originEncounterId": {{atencionOrigenId}},
  "requestingProfessionalId": {{profesionalSolicitaId}},
  "destinationSpecialtyId": {{especialidadInexistenteId}},
  "reason": "Prueba"
}

###

### HU-FASE2-090 — Validación: ID inexistente al consultar (404)
GET {{base}}/{{interconsultaInexistenteId}}
Authorization: {{token}}

###

### HU-FASE2-090 — Validación: editar interconsulta RESPONDIDA (409)
PUT {{base}}/{{interconsultaRespondidaId}}
Content-Type: application/json
Authorization: {{token}}

{
  "destinationSpecialtyId": {{especialidadId}},
  "reason": "Intento de editar tras respuesta"
}

###

### HU-FASE2-090 — Validación: responder interconsulta ya RESPONDIDA (409)
PATCH {{base}}/{{interconsultaRespondidaId}}/respond
Content-Type: application/json
Authorization: {{token}}

{
  "respondingProfessionalId": {{profesionalRespondeId}},
  "response": "Intento de doble respuesta"
}

###

### HU-FASE2-090 — Validación: tomar interconsulta ya tomada (409)
PATCH {{base}}/{{interconsultaRespondidaId}}/take
Content-Type: application/json
Authorization: {{token}}

{
  "respondingProfessionalId": {{profesionalRespondeId}}
}

###

### HU-FASE2-090 — Validación: anular interconsulta RESPONDIDA (409)
PATCH {{base}}/{{interconsultaRespondidaId}}/cancel
Content-Type: application/json
Authorization: {{token}}

{
  "reason": "Intento de anulación tras respuesta"
}

###

### HU-FASE2-090 — Validación: eliminar interconsulta RESPONDIDA (409)
DELETE {{base}}/{{interconsultaRespondidaId}}
Authorization: {{token}}

###

### HU-FASE2-090 — Validación: token faltante (401)
POST {{base}}/list
Content-Type: application/json

{
  "page": 0,
  "rows": 10,
  "search": "",
  "params": {
    "onlyPending": true
  }
}

