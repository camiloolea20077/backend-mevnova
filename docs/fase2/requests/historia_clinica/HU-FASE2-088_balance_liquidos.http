@pacienteInexistenteId = 99999
@profesionalInexistenteId = 99999

### HU-FASE2-088 CA1 — Crear balance turno MAÑANA con items iniciales (ingresos y egresos)
POST {{base}}
Content-Type: application/json
Authorization: {{token}}

{
  "encounterId": {{atencionId}},
  "patientId": {{pacienteId}},
  "professionalId": {{profesionalId}},
  "balanceDate": "2026-05-10",
  "shift": "MANANA",
  "observations": "Balance turno mañana. Paciente con LEV continuos.",
  "items": [
    { "type": "INGRESO", "route": "ORAL", "description": "Agua y jugos", "amountMl": 350, "recordedAt": "08:00:00" },
    { "type": "INGRESO", "route": "IV",   "description": "SSN 0.9% 1000mL en 8h", "amountMl": 333, "recordedAt": "09:00:00" },
    { "type": "EGRESO",  "route": "SVD",  "description": "Diuresis orina clara", "amountMl": 280, "recordedAt": "10:00:00" },
    { "type": "EGRESO",  "route": "INSENSIBLES", "description": "Pérdidas insensibles", "amountMl": 75, "recordedAt": "12:00:00" }
  ]
}

###

### HU-FASE2-088 CA1 — Crear balance turno DIA_24H sin items (se agregan después)
POST {{base}}
Content-Type: application/json
Authorization: {{token}}

{
  "encounterId": {{atencionId}},
  "patientId": {{pacienteId}},
  "professionalId": {{profesionalId}},
  "balanceDate": "2026-05-11",
  "shift": "DIA_24H",
  "observations": "Balance consolidado de 24 horas"
}

###

### HU-FASE2-088 — Consultar balance por ID (incluye items y balance neto calculado)
GET {{base}}/{{balanceId}}
Authorization: {{token}}

###

### HU-FASE2-088 — Listar balances de la atención
POST {{base}}/list
Content-Type: application/json
Authorization: {{token}}

{
  "page": 0,
  "rows": 20,
  "search": "",
  "order_by": "b.fecha_balance",
  "order": "DESC",
  "params": {
    "encounterId": {{atencionId}}
  }
}

###

### HU-FASE2-088 — Balances del paciente del día (rango fecha)
POST {{base}}/list
Content-Type: application/json
Authorization: {{token}}

{
  "page": 0,
  "rows": 50,
  "search": "",
  "order_by": "b.fecha_balance",
  "order": "ASC",
  "params": {
    "patientId": {{pacienteId}},
    "dateFrom": "2026-05-01",
    "dateTo": "2026-05-31"
  }
}

###

### HU-FASE2-088 — Filtrar por turno NOCHE
POST {{base}}/list
Content-Type: application/json
Authorization: {{token}}

{
  "page": 0,
  "rows": 20,
  "search": "",
  "order_by": "b.fecha_balance",
  "order": "DESC",
  "params": {
    "encounterId": {{atencionId}},
    "shift": "NOCHE"
  }
}

###

### HU-FASE2-088 — Búsqueda por texto en observaciones
POST {{base}}/list
Content-Type: application/json
Authorization: {{token}}

{
  "page": 0,
  "rows": 20,
  "search": "LEV",
  "order_by": "b.fecha_balance",
  "order": "DESC",
  "params": {
    "patientId": {{pacienteId}}
  }
}

###

### HU-FASE2-088 — Actualizar header del balance (observaciones)
PUT {{base}}/{{balanceId}}
Content-Type: application/json
Authorization: {{token}}

{
  "professionalId": {{profesionalId}},
  "balanceDate": "2026-05-10",
  "shift": "MANANA",
  "observations": "Balance turno mañana. Diuresis adecuada. Continúa LEV."
}

###

### HU-FASE2-088 CA2 — Agregar item INGRESO (recalcula totales y balance)
POST {{base}}/{{balanceId}}/items
Content-Type: application/json
Authorization: {{token}}

{
  "type": "INGRESO",
  "route": "SNG",
  "description": "Nutrición enteral SNG 250mL",
  "amountMl": 250,
  "recordedAt": "11:00:00"
}

###

### HU-FASE2-088 CA2 — Agregar item EGRESO drenaje
POST {{base}}/{{balanceId}}/items
Content-Type: application/json
Authorization: {{token}}

{
  "type": "EGRESO",
  "route": "DRENAJE",
  "description": "Drenaje hemovac MID",
  "amountMl": 50,
  "recordedAt": "11:30:00"
}

###

### HU-FASE2-088 — Listar items del balance
GET {{base}}/{{balanceId}}/items
Authorization: {{token}}

###

### HU-FASE2-088 — Eliminar item lógicamente (recalcula totales)
DELETE {{base}}/{{balanceId}}/items/{{itemId}}
Authorization: {{token}}

###

### HU-FASE2-088 — Eliminación lógica del balance completo
DELETE {{base}}/{{balanceId}}
Authorization: {{token}}

###

