@port = 9001
@token = Bearer eyJhbGciOiJIUzUxMiJ9..5alQHZv6qS411enEHOGrH-KKL_NhwohmLA8D9B_8NBdzedB24t8XJAW8X0SSOgTbZv_xoz_8qi6nn1WIaAkBdQ

@base = http://localhost:{{port}}/api/system-reviews

@atencionId = 1
@otraAtencionId = 2
@pacienteId = 5
@revisionId = 1
@revisionInexistenteId = 99999
@atencionInexistenteId = 99999

### HU-FASE2-082 — Crear revisión CARDIOVASCULAR sin alteración
POST {{base}}
Content-Type: application/json
Authorization: {{token}}

{
  "encounterId": {{atencionId}},
  "system": "CARDIOVASCULAR",
  "withoutAlteration": true
}

###

### HU-FASE2-082 — Crear revisión RESPIRATORIO con hallazgos
POST {{base}}
Content-Type: application/json
Authorization: {{token}}

{
  "encounterId": {{atencionId}},
  "system": "RESPIRATORIO",
  "withoutAlteration": false,
  "findings": "Estertores bibasales finos, predominio en base derecha. SatO2 92% en aire ambiente."
}

###

### HU-FASE2-082 — Crear revisión NEUROLOGICO sin alteración
POST {{base}}
Content-Type: application/json
Authorization: {{token}}

{
  "encounterId": {{atencionId}},
  "system": "NEUROLOGICO",
  "withoutAlteration": true
}

###

### HU-FASE2-082 — Crear revisión GASTROINTESTINAL con hallazgos
POST {{base}}
Content-Type: application/json
Authorization: {{token}}

{
  "encounterId": {{atencionId}},
  "system": "GASTROINTESTINAL",
  "withoutAlteration": false,
  "findings": "Dolor abdominal en epigastrio leve, sin signos de irritación peritoneal."
}

###

### HU-FASE2-082 — Consultar revisión por ID
GET {{base}}/{{revisionId}}
Authorization: {{token}}

###

### HU-FASE2-082 — Listar revisiones de una atención
POST {{base}}/list
Content-Type: application/json
Authorization: {{token}}

{
  "page": 0,
  "rows": 20,
  "search": "",
  "order_by": "r.created_at",
  "order": "DESC",
  "params": {
    "encounterId": {{atencionId}}
  }
}

###

### HU-FASE2-082 — Listar todas las revisiones de un paciente (cronología)
POST {{base}}/list
Content-Type: application/json
Authorization: {{token}}

{
  "page": 0,
  "rows": 50,
  "search": "",
  "order_by": "r.created_at",
  "order": "DESC",
  "params": {
    "patientId": {{pacienteId}}
  }
}

###

### HU-FASE2-082 — Filtrar por sistema (CARDIOVASCULAR) en una atención
POST {{base}}/list
Content-Type: application/json
Authorization: {{token}}

{
  "page": 0,
  "rows": 20,
  "search": "",
  "order_by": "r.created_at",
  "order": "DESC",
  "params": {
    "encounterId": {{atencionId}},
    "system": "CARDIOVASCULAR"
  }
}

###

### HU-FASE2-082 — Listar solo sistemas con alteración (hallazgos)
POST {{base}}/list
Content-Type: application/json
Authorization: {{token}}

{
  "page": 0,
  "rows": 20,
  "search": "",
  "order_by": "r.created_at",
  "order": "DESC",
  "params": {
    "encounterId": {{atencionId}},
    "withoutAlteration": false
  }
}

###

### HU-FASE2-082 — Búsqueda por texto en hallazgos
POST {{base}}/list
Content-Type: application/json
Authorization: {{token}}

{
  "page": 0,
  "rows": 20,
  "search": "estertores",
  "order_by": "r.created_at",
  "order": "DESC",
  "params": {
    "encounterId": {{atencionId}}
  }
}

###

### HU-FASE2-082 — Actualizar revisión (cambia a con alteración + hallazgos)
PUT {{base}}/{{revisionId}}
Content-Type: application/json
Authorization: {{token}}

{
  "system": "CARDIOVASCULAR",
  "withoutAlteration": false,
  "findings": "Soplo sistólico II/VI en foco aórtico, sin irradiación. Pulsos simétricos."
}

###

### HU-FASE2-082 — Inactivar revisión
PATCH {{base}}/{{revisionId}}/deactivate
Authorization: {{token}}

###

### HU-FASE2-082 — Reactivar revisión
PATCH {{base}}/{{revisionId}}/activate
Authorization: {{token}}

###

### HU-FASE2-082 — Eliminación lógica
DELETE {{base}}/{{revisionId}}
Authorization: {{token}}

###

### HU-FASE2-082 — Validación: campo obligatorio (system faltante)
POST {{base}}
Content-Type: application/json
Authorization: {{token}}

{
  "encounterId": {{atencionId}},
  "withoutAlteration": true
}

