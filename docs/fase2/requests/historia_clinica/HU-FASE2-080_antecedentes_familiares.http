@port = 9001
@token = Bearer eyJhbGciOiJIUzUxMiJ9..5alQHZv6qS411enEHOGrH-KKL_NhwohmLA8D9B_8NBdzedB24t8XJAW8X0SSOgTbZv_xoz_8qi6nn1WIaAkBdQ

@base = http://localhost:{{port}}/api/family-antecedents

@pacienteId = 5
@otroPacienteId = 2
@catalogoDiagnosticoId = 145
@antecedenteFamiliarId = 1
@antecedenteFamiliarInexistenteId = 99999
@pacienteInexistenteId = 99999

### HU-FASE2-080 — Crear antecedente familiar (madre con HTA)
POST {{base}}
Content-Type: application/json
Authorization: {{token}}

{
  "patientId": {{pacienteId}},
  "kinship": "MADRE",
  "catalogDiagnosisId": {{catalogoDiagnosticoId}},
  "description": "Hipertensión arterial diagnosticada a los 45 años, controlada con tratamiento.",
  "ageOfOnset": 45,
  "isDeceased": false,
  "observations": "Antecedente relevante de riesgo cardiovascular hereditario."
}

###

### HU-FASE2-080 — Crear antecedente familiar (padre fallecido por IAM)
POST {{base}}
Content-Type: application/json
Authorization: {{token}}

{
  "patientId": {{pacienteId}},
  "kinship": "PADRE",
  "description": "Infarto agudo de miocardio a los 60 años.",
  "ageOfOnset": 58,
  "isDeceased": true,
  "causeOfDeath": "Infarto agudo de miocardio masivo",
  "observations": "Padre fallecido por IAM. Reforzar tamizaje cardiovascular en el paciente."
}

###

### HU-FASE2-080 — Crear antecedente familiar (hermano con diabetes)
POST {{base}}
Content-Type: application/json
Authorization: {{token}}

{
  "patientId": {{pacienteId}},
  "kinship": "HERMANO",
  "description": "Diabetes mellitus tipo 2 en manejo con metformina.",
  "ageOfOnset": 38,
  "isDeceased": false
}

###

### HU-FASE2-080 — Consultar antecedente familiar por ID
GET {{base}}/{{antecedenteFamiliarId}}
Authorization: {{token}}

###

### HU-FASE2-080 — Listar antecedentes familiares del paciente
POST {{base}}/list
Content-Type: application/json
Authorization: {{token}}

{
  "page": 0,
  "rows": 20,
  "search": "",
  "order_by": "a.created_at",
  "order": "DESC",
  "params": {
    "patientId": {{pacienteId}}
  }
}

###

### HU-FASE2-080 — Listar solo familiares fallecidos del paciente
POST {{base}}/list
Content-Type: application/json
Authorization: {{token}}

{
  "page": 0,
  "rows": 20,
  "search": "",
  "order_by": "a.created_at",
  "order": "DESC",
  "params": {
    "patientId": {{pacienteId}},
    "onlyDeceased": true
  }
}

###

### HU-FASE2-080 — Listar filtrando por parentesco (MADRE)
POST {{base}}/list
Content-Type: application/json
Authorization: {{token}}

{
  "page": 0,
  "rows": 20,
  "search": "",
  "order_by": "a.created_at",
  "order": "DESC",
  "params": {
    "patientId": {{pacienteId}},
    "kinship": "MADRE"
  }
}

###

### HU-FASE2-080 — Búsqueda por texto (descripción/causa/diagnóstico)
POST {{base}}/list
Content-Type: application/json
Authorization: {{token}}

{
  "page": 0,
  "rows": 20,
  "search": "infarto",
  "order_by": "a.created_at",
  "order": "DESC",
  "params": {
    "patientId": {{pacienteId}}
  }
}

###

### HU-FASE2-080 — Listar solo antecedentes familiares activos
POST {{base}}/list
Content-Type: application/json
Authorization: {{token}}

{
  "page": 0,
  "rows": 20,
  "search": "",
  "order_by": "a.created_at",
  "order": "DESC",
  "params": {
    "patientId": {{pacienteId}},
    "onlyActive": true
  }
}

###

### HU-FASE2-080 — Actualizar antecedente familiar
PUT {{base}}/{{antecedenteFamiliarId}}
Content-Type: application/json
Authorization: {{token}}

{
  "kinship": "MADRE",
  "catalogDiagnosisId": {{catalogoDiagnosticoId}},
  "description": "Hipertensión arterial controlada con losartán y dieta hiposódica.",
  "ageOfOnset": 45,
  "isDeceased": false,
  "observations": "Buen control en último año."
}

###

### HU-FASE2-080 — Inactivar antecedente familiar (queda histórico)
PATCH {{base}}/{{antecedenteFamiliarId}}/deactivate
Authorization: {{token}}

###

### HU-FASE2-080 — Reactivar antecedente familiar
PATCH {{base}}/{{antecedenteFamiliarId}}/activate
Authorization: {{token}}

###

### HU-FASE2-080 — Eliminación lógica
DELETE {{base}}/{{antecedenteFamiliarId}}
Authorization: {{token}}

###

### HU-FASE2-080 — Validación: campo obligatorio (description faltante)
POST {{base}}
Content-Type: application/json
Authorization: {{token}}

{
  "patientId": {{pacienteId}},
  "kinship": "TIO"
}

###

