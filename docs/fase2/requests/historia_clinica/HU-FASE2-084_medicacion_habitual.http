@port = 9001
@token = Bearer eyJhbGciOiJIUzUxMiJ9..5alQHZv6qS411enEHOGrH-KKL_NhwohmLA8D9B_8NBdzedB24t8XJAW8X0SSOgTbZv_xoz_8qi6nn1WIaAkBdQ

@base = http://localhost:{{port}}/api/regular-medications

@pacienteId = 5
@otroPacienteId = 2
@servicioSaludId = 3
@viaOralId = 27
@viaIntramuscularId = 1
@frecuenciaQDId = 23
@medicacionId = 1
@medicacionInexistenteId = 99999
@pacienteInexistenteId = 99999
@servicioInexistenteId = 99999

### HU-FASE2-084 — Registrar medicación habitual (Losartán crónico)
POST {{base}}
Content-Type: application/json
Authorization: {{token}}

{
  "patientId": {{pacienteId}},
  "healthServiceId": {{servicioSaludId}},
  "medicationName": "Losartán 50 mg",
  "dose": "50 mg",
  "administrationRouteId": {{viaOralId}},
  "doseFrequencyId": {{frecuenciaQDId}},
  "startDate": "2021-03-12",
  "indication": "Hipertensión arterial",
  "prescribingProfessional": "Dr. Juan Pérez — Cardiología",
  "isCurrentlyTaking": true,
  "observations": "Buen control en último año."
}

###

### HU-FASE2-084 — Registrar medicación con texto libre (sin homologar)
POST {{base}}
Content-Type: application/json
Authorization: {{token}}

{
  "patientId": {{pacienteId}},
  "medicationName": "Vitamina D3 1000 UI",
  "dose": "1 cápsula",
  "doseFrequencyId": {{frecuenciaQDId}},
  "startDate": "2024-01-01",
  "indication": "Suplemento por déficit de vitamina D",
  "prescribingProfessional": "Auto-medicación (paciente refiere)",
  "isCurrentlyTaking": true
}

###

### HU-FASE2-084 — Registrar medicación suspendida con fecha de fin
POST {{base}}
Content-Type: application/json
Authorization: {{token}}

{
  "patientId": {{pacienteId}},
  "medicationName": "Omeprazol 20 mg",
  "dose": "20 mg",
  "doseFrequencyId": {{frecuenciaQDId}},
  "startDate": "2023-06-01",
  "endDate": "2023-12-15",
  "indication": "Gastritis",
  "isCurrentlyTaking": false,
  "observations": "Suspendido por mejoría clínica."
}

###

### HU-FASE2-084 — Consultar medicación por ID
GET {{base}}/{{medicacionId}}
Authorization: {{token}}

###

### HU-FASE2-084 — Listar medicación habitual del paciente
POST {{base}}/list
Content-Type: application/json
Authorization: {{token}}

{
  "page": 0,
  "rows": 50,
  "search": "",
  "order_by": "m.created_at",
  "order": "DESC",
  "params": {
    "patientId": {{pacienteId}}
  }
}

###

### HU-FASE2-084 — Listar solo medicamentos vigentes (los que aún toma)
POST {{base}}/list
Content-Type: application/json
Authorization: {{token}}

{
  "page": 0,
  "rows": 50,
  "search": "",
  "order_by": "m.created_at",
  "order": "DESC",
  "params": {
    "patientId": {{pacienteId}},
    "onlyCurrentlyTaking": true
  }
}

###

### HU-FASE2-084 — Filtrar por servicio de salud (medicamento homologado)
POST {{base}}/list
Content-Type: application/json
Authorization: {{token}}

{
  "page": 0,
  "rows": 20,
  "search": "",
  "order_by": "m.created_at",
  "order": "DESC",
  "params": {
    "patientId": {{pacienteId}},
    "healthServiceId": {{servicioSaludId}}
  }
}

###

### HU-FASE2-084 — Búsqueda por texto en nombre/indicación/profesional
POST {{base}}/list
Content-Type: application/json
Authorization: {{token}}

{
  "page": 0,
  "rows": 20,
  "search": "losartan",
  "order_by": "m.created_at",
  "order": "DESC",
  "params": {
    "patientId": {{pacienteId}}
  }
}

###

### HU-FASE2-084 — Listar solo medicamentos activos
POST {{base}}/list
Content-Type: application/json
Authorization: {{token}}

{
  "page": 0,
  "rows": 20,
  "search": "",
  "order_by": "m.created_at",
  "order": "DESC",
  "params": {
    "patientId": {{pacienteId}},
    "onlyActive": true
  }
}

###

### HU-FASE2-084 — Actualizar medicación (cambia dosis)
PUT {{base}}/{{medicacionId}}
Content-Type: application/json
Authorization: {{token}}

{
  "healthServiceId": {{servicioSaludId}},
  "medicationName": "Losartán 100 mg",
  "dose": "100 mg",
  "administrationRouteId": {{viaOralId}},
  "doseFrequencyId": {{frecuenciaQDId}},
  "startDate": "2021-03-12",
  "indication": "Hipertensión arterial — incremento de dosis",
  "prescribingProfessional": "Dr. Juan Pérez — Cardiología",
  "isCurrentlyTaking": true,
  "observations": "Se duplica dosis por TA persistentemente alta."
}

###

### HU-FASE2-084 — Marcar como vigente (vuelve a tomar)
PATCH {{base}}/{{medicacionId}}/start
Authorization: {{token}}

###

### HU-FASE2-084 — Marcar como suspendido (deja de tomar)
PATCH {{base}}/{{medicacionId}}/stop
Authorization: {{token}}

###

### HU-FASE2-084 — Inactivar medicación
PATCH {{base}}/{{medicacionId}}/deactivate
Authorization: {{token}}

###

### HU-FASE2-084 — Reactivar medicación
PATCH {{base}}/{{medicacionId}}/activate
Authorization: {{token}}

###

### HU-FASE2-084 — Eliminación lógica
DELETE {{base}}/{{medicacionId}}
Authorization: {{token}}

###

### HU-FASE2-084 — Validación: campo obligatorio (medicationName faltante)
POST {{base}}
Content-Type: application/json
Authorization: {{token}}

{
  "patientId": {{pacienteId}},
  "dose": "10 mg"
}

