@port = 9001
@token = Bearer eyJhbGciOiJIUzUxMiJ9..5alQHZv6qS411enEHOGrH-KKL_NhwohmLA8D9B_8NBdzedB24t8XJAW8X0SSOgTbZv_xoz_8qi6nn1WIaAkBdQ

@base = http://localhost:{{port}}/api/nursing-care-plans

@atencionId = 1
@otraAtencionId = 2
@pacienteId = 5
@profesionalId = 2
@planId = 1
@planInexistenteId = 99999
@atencionInexistenteId = 99999
@pacienteInexistenteId = 99999
@profesionalInexistenteId = 99999

### HU-FASE2-085 — Crear plan de cuidados (NANDA/NOC/NIC)
POST {{base}}
Content-Type: application/json
Authorization: {{token}}

{
  "encounterId": {{atencionId}},
  "patientId": {{pacienteId}},
  "professionalId": {{profesionalId}},
  "planDate": "2026-05-08",
  "nursingDiagnosis": "(NANDA) Riesgo de caídas R/C debilidad muscular y deterioro del equilibrio.",
  "objectives": "(NOC) Mantener seguridad ambiental. Reducir el riesgo de caídas a 0 durante la hospitalización.",
  "interventions": "(NIC) Prevención de caídas: barandillas elevadas, timbre al alcance, asistencia para movilización, calzado antideslizante.",
  "status": "ACTIVO"
}

###

### HU-FASE2-085 — Crear plan de cuidados con evaluación inicial
POST {{base}}
Content-Type: application/json
Authorization: {{token}}

{
  "encounterId": {{atencionId}},
  "patientId": {{pacienteId}},
  "professionalId": {{profesionalId}},
  "nursingDiagnosis": "(NANDA) Dolor agudo R/C proceso quirúrgico EVI.",
  "objectives": "(NOC) Control del dolor: EVA <= 3 a las 24 horas postquirúrgicas.",
  "interventions": "(NIC) Manejo del dolor: administración analgésica programada, monitoreo EVA c/4h, técnicas de relajación.",
  "evaluation": "EVA inicial 7/10. Inicia esquema analgésico.",
  "status": "ACTIVO"
}

###

### HU-FASE2-085 — Consultar plan por ID
GET {{base}}/{{planId}}
Authorization: {{token}}

###

### HU-FASE2-085 — Listar planes de la atención
POST {{base}}/list
Content-Type: application/json
Authorization: {{token}}

{
  "page": 0,
  "rows": 20,
  "search": "",
  "order_by": "p.fecha_plan",
  "order": "DESC",
  "params": {
    "encounterId": {{atencionId}}
  }
}

###

### HU-FASE2-085 — Listar planes ACTIVO del paciente
POST {{base}}/list
Content-Type: application/json
Authorization: {{token}}

{
  "page": 0,
  "rows": 20,
  "search": "",
  "order_by": "p.fecha_plan",
  "order": "DESC",
  "params": {
    "patientId": {{pacienteId}},
    "onlyActiveStatus": true
  }
}

###

### HU-FASE2-085 — Filtrar por estado SUSPENDIDO
POST {{base}}/list
Content-Type: application/json
Authorization: {{token}}

{
  "page": 0,
  "rows": 20,
  "search": "",
  "order_by": "p.fecha_plan",
  "order": "DESC",
  "params": {
    "patientId": {{pacienteId}},
    "status": "SUSPENDIDO"
  }
}

###

### HU-FASE2-085 — Filtrar por profesional responsable
POST {{base}}/list
Content-Type: application/json
Authorization: {{token}}

{
  "page": 0,
  "rows": 20,
  "search": "",
  "order_by": "p.fecha_plan",
  "order": "DESC",
  "params": {
    "professionalId": {{profesionalId}}
  }
}

###

### HU-FASE2-085 — Búsqueda por texto en diagnostico/objetivos/intervenciones
POST {{base}}/list
Content-Type: application/json
Authorization: {{token}}

{
  "page": 0,
  "rows": 20,
  "search": "caidas",
  "order_by": "p.fecha_plan",
  "order": "DESC",
  "params": {
    "patientId": {{pacienteId}}
  }
}

###

### HU-FASE2-085 — Actualizar plan (agrega evaluación periódica)
PUT {{base}}/{{planId}}
Content-Type: application/json
Authorization: {{token}}

{
  "professionalId": {{profesionalId}},
  "planDate": "2026-05-08",
  "nursingDiagnosis": "(NANDA) Riesgo de caídas R/C debilidad muscular.",
  "objectives": "(NOC) Mantener seguridad ambiental. Reducir el riesgo de caídas.",
  "interventions": "(NIC) Prevención de caídas + ejercicios pasivos en cama.",
  "evaluation": "Sin caídas en las últimas 48 horas. Mejora del balance al sentarse.",
  "status": "ACTIVO"
}

###

### HU-FASE2-085 — Cambiar estado a CUMPLIDO (al egreso)
PATCH {{base}}/{{planId}}/status
Content-Type: application/json
Authorization: {{token}}

{
  "status": "CUMPLIDO",
  "evaluation": "Plan cumplido al egreso. Paciente sin caídas durante hospitalización."
}

###

### HU-FASE2-085 — Cambiar estado a SUSPENDIDO con motivo
PATCH {{base}}/{{planId}}/status
Content-Type: application/json
Authorization: {{token}}

{
  "status": "SUSPENDIDO",
  "evaluation": "Plan suspendido por traslado a UCI."
}

###

### HU-FASE2-085 — Cambiar estado a MODIFICADO
PATCH {{base}}/{{planId}}/status
Content-Type: application/json
Authorization: {{token}}

{
  "status": "MODIFICADO",
  "evaluation": "Se ajustan intervenciones según nueva orden médica."
}

###

### HU-FASE2-085 — Inactivar plan
PATCH {{base}}/{{planId}}/deactivate
Authorization: {{token}}

###

### HU-FASE2-085 — Reactivar plan
PATCH {{base}}/{{planId}}/activate
Authorization: {{token}}

###

### HU-FASE2-085 — Eliminación lógica
DELETE {{base}}/{{planId}}
Authorization: {{token}}

###

### HU-FASE2-085 — Validación: campo obligatorio (nursingDiagnosis faltante)
POST {{base}}
Content-Type: application/json
Authorization: {{token}}

{
  "encounterId": {{atencionId}},
  "patientId": {{pacienteId}},
  "professionalId": {{profesionalId}},
  "objectives": "Sólo objetivos sin diagnóstico",
  "interventions": "Intervenciones genéricas"
}

###

### HU-FASE2-085 — Validación: estado inválido (400)
POST {{base}}
Content-Type: application/json
Authorization: {{token}}

{
  "encounterId": {{atencionId}},
  "patientId": {{pacienteId}},
  "professionalId": {{profesionalId}},
  "nursingDiagnosis": "Diagnóstico de prueba",
  "objectives": "Objetivo",
  "interventions": "Intervenciones",
  "status": "EN_PAUSA"
}

