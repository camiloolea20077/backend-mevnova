@base = http://localhost:{{port}}/api/patient-vaccines

@pacienteId = 5
@otroPacienteId = 2
@viaIntramuscularId = 30
@viaOralId = 2
@profesionalId = 2
@vacunaId = 1
@vacunaInexistenteId = 99999
@pacienteInexistenteId = 99999
@viaInexistenteId = 99999

### HU-FASE2-083 — Registrar vacuna COVID-19 dosis 1
POST {{base}}
Content-Type: application/json
Authorization: {{token}}

{
  "patientId": {{pacienteId}},
  "vaccineName": "COVID-19 Pfizer/BioNTech",
  "vaccineCode": "COVID19",
  "doseNumber": 1,
  "totalSchemeDoses": 3,
  "applicationDate": "2024-03-10",
  "nextDoseDate": "2024-04-10",
  "laboratory": "Pfizer",
  "batchNumber": "FA1234-22",
  "administrationRouteId": {{viaIntramuscularId}},
  "applyingProfessionalId": {{profesionalId}},
  "observations": "Vacuna aplicada en deltoides izquierdo, sin reacciones inmediatas."
}

###

### HU-FASE2-083 — Registrar vacuna COVID-19 dosis 2
POST {{base}}
Content-Type: application/json
