### HU-FASE2-083 — Registrar vacuna aplicada en otra institución
POST {{base}}
Content-Type: application/json
Authorization: {{token}}

{
  "patientId": {{pacienteId}},
  "vaccineName": "Tétanos (toxoide tetánico)",
  "vaccineCode": "TT",
  "doseNumber": 1,
  "totalSchemeDoses": 1,
  "applicationDate": "2023-08-22",
  "laboratory": "Sanofi",
  "batchNumber": "T2023-09",
  "administrationRouteId": {{viaIntramuscularId}},
  "applyingInstitution": "Hospital San Vicente — Medellín",
  "observations": "Aplicación reportada por el paciente; no hay registro local."
}

###

### HU-FASE2-083 — Registrar vacuna BCG (recién nacido)
POST {{base}}
Content-Type: application/json
Authorization: {{token}}

{
  "patientId": {{pacienteId}},
  "vaccineName": "BCG",
  "vaccineCode": "BCG",
  "doseNumber": 1,
  "totalSchemeDoses": 1,
  "applicationDate": "2024-01-15",
  "administrationRouteId": {{viaIntramuscularId}},
  "applyingProfessionalId": {{profesionalId}}
}

###

### HU-FASE2-083 — Consultar vacuna por ID
GET {{base}}/{{vacunaId}}
Authorization: {{token}}

###

### HU-FASE2-083 — Cronología de vacunas del paciente
POST {{base}}/list
Content-Type: application/json
Authorization: {{token}}

{
  "page": 0,
  "rows": 50,
  "search": "",
  "order_by": "v.fecha_aplicacion",
  "order": "DESC",
  "params": {
    "patientId": {{pacienteId}}
  }
}

###

### HU-FASE2-083 — Filtrar por código de vacuna (esquema COVID)
POST {{base}}/list
Content-Type: application/json
Authorization: {{token}}

{
  "page": 0,
  "rows": 20,
  "search": "",
  "order_by": "v.dosis",
  "order": "ASC",
  "params": {
    "patientId": {{pacienteId}},
    "vaccineCode": "COVID19"
  }
}

###

### HU-FASE2-083 — Próximas dosis pendientes en una ventana
POST {{base}}/list
Content-Type: application/json
Authorization: {{token}}

{
  "page": 0,
  "rows": 50,
  "search": "",
  "order_by": "v.fecha_proxima_dosis",
  "order": "ASC",
  "params": {
    "patientId": {{pacienteId}},
    "nextDoseFrom": "2024-04-01",
    "nextDoseTo": "2024-12-31"
  }
}

###

### HU-FASE2-083 — Búsqueda por texto (nombre, lote o laboratorio)
POST {{base}}/list
Content-Type: application/json
Authorization: {{token}}

{
  "page": 0,
  "rows": 20,
  "search": "pfizer",
  "order_by": "v.fecha_aplicacion",
  "order": "DESC",
  "params": {
    "patientId": {{pacienteId}}
  }
}

###

### HU-FASE2-083 — Listar solo vacunas activas
POST {{base}}/list
Content-Type: application/json
Authorization: {{token}}

{
  "page": 0,
  "rows": 20,
  "search": "",
  "order_by": "v.fecha_aplicacion",
  "order": "DESC",
  "params": {
    "patientId": {{pacienteId}},
    "onlyActive": true
  }
}

###

### HU-FASE2-083 — Actualizar vacuna (corrige fecha próxima dosis)
PUT {{base}}/{{vacunaId}}
Content-Type: application/json
Authorization: {{token}}

{
  "vaccineName": "COVID-19 Pfizer/BioNTech",
  "vaccineCode": "COVID19",
  "doseNumber": 1,
  "totalSchemeDoses": 3,
  "applicationDate": "2024-03-10",
  "nextDoseDate": "2024-05-10",
  "laboratory": "Pfizer",
  "batchNumber": "FA1234-22",
  "administrationRouteId": {{viaIntramuscularId}},
  "applyingProfessionalId": {{profesionalId}},
  "observations": "Se reprograma 2da dosis por desabasto temporal."
}

###

### HU-FASE2-083 — Inactivar vacuna
PATCH {{base}}/{{vacunaId}}/deactivate
Authorization: {{token}}

###

### HU-FASE2-083 — Reactivar vacuna
PATCH {{base}}/{{vacunaId}}/activate
Authorization: {{token}}

###

### HU-FASE2-083 — Eliminación lógica
DELETE {{base}}/{{vacunaId}}
Authorization: {{token}}

###

